    "@strapi/plugin-users-permissions": "5.43.0",
    "@strapi/strapi": "5.43.0",
    "algoliasearch": "^5.50.2",
    "better-sqlite3": "11.3.0",
    "esbuild": "0.25.12",
    "fs-extra": "^10.0.0",
    "mime-types": "^2.1.27",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.0.0",
