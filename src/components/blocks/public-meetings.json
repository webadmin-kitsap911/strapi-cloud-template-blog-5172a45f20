{
  "collectionName": "components_blocks_public_meetings",
  "info": {
    "displayName": "Public Meetings",
    "description": "Display upcoming and past public meetings",
    "icon": "calendar"
  },
  "options": {},
  "attributes": {
    "limit": {
      "type": "integer",
      "min": 1,
      "max": 50,
      "default": 10,
      "pluginOptions": {
        "content-manager": {
          "description": "Maximum number of meetings to show"
        }
      }
    },
    "showPast": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "content-manager": {
          "description": "Include past meetings in the list"
        }
      }
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "none",
        "standard",
        "darker",
        "brighter",
        "force-light:standard",
        "force-light:darker",
        "force-light:brighter",
        "force-dark:standard",
        "force-dark:darker",
        "force-dark:brighter",
        "invert:standard",
        "invert:darker",
        "invert:brighter"
      ],
      "default": "none"
    }
  }
}
