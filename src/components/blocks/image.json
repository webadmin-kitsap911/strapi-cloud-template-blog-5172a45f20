{
  "collectionName": "components_blocks_images",
  "info": {
    "displayName": "Image",
    "description": "Image with optional caption. Alt text is set in the media library.",
    "icon": "image"
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "caption": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "description": "Optional text displayed below the image"
        }
      }
    },
    "theme": {
      "type": "enumeration",
      "required": true,
      "enum": ["none", "standard", "brighter", "darker"],
      "default": "standard"
    }
  }
}
