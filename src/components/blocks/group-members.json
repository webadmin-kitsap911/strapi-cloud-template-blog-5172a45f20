{
  "collectionName": "components_blocks_group_members",
  "info": {
    "displayName": "Group Members",
    "description": "Display a grid of staff members or team members",
    "icon": "users"
  },
  "options": {},
  "attributes": {
    "limit": {
      "type": "integer",
      "min": 1,
      "max": 100,
      "pluginOptions": {
        "content-manager": {
          "description": "Maximum number of members to show (leave empty for all)"
        }
      }
    },
    "filterByTag": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::staff-tag.staff-tag",
      "pluginOptions": {
        "content-manager": {
          "description": "Only show members with this tag (e.g., 'Board', 'Leadership')"
        }
      }
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "none",
        "standard",
        "darker",
        "brighter",
        "force-light:standard",
        "force-light:darker",
        "force-light:brighter",
        "force-dark:standard",
        "force-dark:darker",
        "force-dark:brighter",
        "invert:standard",
        "invert:darker",
        "invert:brighter"
      ],
      "default": "none"
    }
  }
}
