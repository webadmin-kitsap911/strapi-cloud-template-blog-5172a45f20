{
  "collectionName": "components_blocks_press_releases",
  "info": {
    "displayName": "Press Releases",
    "description": "Display a list of recent press releases",
    "icon": "newspaper"
  },
  "options": {},
  "attributes": {
    "limit": {
      "type": "integer",
      "min": 1,
      "max": 50,
      "default": 10,
      "pluginOptions": {
        "content-manager": {
          "description": "Maximum number of press releases to show"
        }
      }
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "none",
        "standard",
        "darker",
        "brighter",
        "force-light:standard",
        "force-light:darker",
        "force-light:brighter",
        "force-dark:standard",
        "force-dark:darker",
        "force-dark:brighter",
        "invert:standard",
        "invert:darker",
        "invert:brighter"
      ],
      "default": "none"
    }
  }
}
