{
  "kind": "singleType",
  "collectionName": "global_settings",
  "info": {
    "singularName": "global-settings",
    "pluralName": "all-global-settings",
    "displayName": "Global Settings",
    "description": "Site-wide default settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "defaultMeetingUrl": {
      "type": "string",
      "regex": "^https?://.*"
    },
    "defaultPageBackgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "socialMediaLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-media-link"
    },
    "pressReleasesPage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "pluginOptions": {
        "content-manager": {
          "description": "Page used as parent for press release detail pages"
        }
      }
    },
    "contractOpportunitiesBackgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "headerContacts": {
      "type": "component",
      "repeatable": true,
      "component": "shared.header-contact",
      "max": 2,
      "pluginOptions": {
        "content-manager": {
          "description": "Contact lines displayed in the header (max 2)"
        }
      }
    },
    "footerText": {
      "type": "richtext",
      "pluginOptions": {
        "content-manager": {
          "description": "Text displayed in the footer"
        }
      }
    }
  }
}
