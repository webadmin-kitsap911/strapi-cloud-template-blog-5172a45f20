{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Hierarchical pages with flexible content blocks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "parent",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "path": {
      "type": "string",
      "description": "Full path computed from hierarchy (e.g., /about/team/leadership)",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "contentBlocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.rich-text",
        "blocks.image",
        "blocks.heading",
        "blocks.call-to-action",
        "blocks.embed",
        "blocks.press-releases",
        "blocks.public-meetings",
        "blocks.group-members",
        "blocks.public-records-request-form",
        "blocks.contact-form"
      ]
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
